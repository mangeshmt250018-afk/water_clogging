# ==========================================
# Water Clogging Reporter - Environment Config
# ==========================================

# Required Production Variables
SECRET_KEY=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
GOVERNMENT_AUTHORITY_EMAIL=

# Mail Server Configuration
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USE_SSL=

# Redis URL for production rate limiting
# Example:
# RATELIMIT_STORAGE_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URL=

# Security & Cookie Configuration (Defaults to True in production)
SESSION_COOKIE_SECURE=True
REMEMBER_COOKIE_SECURE=True
ENABLE_HSTS=True

# Application Modes (Defaults to False in production)
FLASK_DEBUG=False
TESTING=False
